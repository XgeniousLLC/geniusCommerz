APP_NAME=geniusCommerz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Database (MySQL 8) ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=klixbd
DB_USERNAME=root
DB_PASSWORD=

# ─── Cache / Queue / Session ──────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Storage (S3) ─────────────────────────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_CDN_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@geniuscommerz.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Broadcast (Pusher) ───────────────────────────────────────────────────────
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap2
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ─── SMS ──────────────────────────────────────────────────────────────────────
SMS_DRIVER=ssl_wireless
SSL_WIRELESS_API_KEY=
ALPHA_SMS_API_KEY=
SMS_SENDER_ID=KLIXBD

# ─── Payments ─────────────────────────────────────────────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ─── Couriers ─────────────────────────────────────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_MERCHANT_ID=
PATHAO_BASE_URL=https://hermes-api.p-stageenv.xyz

STEADFAST_API_KEY=
STEADFAST_API_SECRET=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/public/api/v1

REDX_API_TOKEN=
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta

# ─── Fraud ────────────────────────────────────────────────────────────────────
FRAUDBD_API_KEY=
FRAUDCHECKER_API_KEY=

# ─── Tracking ─────────────────────────────────────────────────────────────────
GTM_WEB_ID=
SGTM_URL=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_TOKEN=
VITE_GTM_WEB_ID="${GTM_WEB_ID}"
VITE_META_PIXEL_ID="${META_PIXEL_ID}"

# ─── Observability ────────────────────────────────────────────────────────��───
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TELESCOPE_ENABLED=false
